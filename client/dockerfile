# Build stage
FROM node:18-alpine AS build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ .

# Print angular.json for debugging
RUN cat angular.json | grep outputPath

# Build with debug info
RUN npm run build --configuration=production -- --verbose
RUN ls -la
RUN ls -la dist || echo "No dist folder"
RUN find dist -type f | sort || echo "Cannot find files in dist"

# Production stage
FROM nginx:alpine
# Try this path - adjust based on build output
COPY --from=build /app/dist/client/ /usr/share/nginx/html/
# Create a test file to confirm nginx is serving files
RUN echo "<html><body><h1>Test Page</h1></body></html>" > /usr/share/nginx/html/test.html
COPY client/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]