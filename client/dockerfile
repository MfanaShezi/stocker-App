# Build stage
FROM node:18-alpine AS build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ .

# Print angular.json for debugging
RUN cat angular.json | grep outputPath || echo "No outputPath found"

# Build with production configuration
# Note: flags come AFTER the --, not before
RUN npm run build --  --configuration production --verbose

# Debug: Show what was built
RUN echo "=== Root directory ===" && ls -la
RUN echo "=== Dist folder ===" && ls -la dist/ || echo "No dist folder"
RUN echo "=== All files in dist ===" && find dist -type f | sort || echo "Cannot find files in dist"

RUN echo "=== Build completed, checking output ===" && \
    ls -la dist/client/browser/ && \
    echo "=== index.html exists? ===" && \
    test -f dist/client/browser/index.html && echo "YES" || echo "NO"
# Production stage
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# Remove default nginx files
RUN rm -rf ./*

# Try this path - adjust based on build output above
COPY --from=build /app/dist/client/ /usr/share/nginx/html/

# Verify files were copied
RUN echo "=== Nginx html directory ===" && ls -la

# Copy nginx config
COPY client/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]